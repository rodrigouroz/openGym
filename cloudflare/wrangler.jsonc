{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengym",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "GYM", "class_name": "Gym" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gym"] }],
  "vars": { "ORIGIN": "http://localhost:8787", "RP_ID": "localhost", "FIRST_USER_ADMIN": "1", "ALLOW_GUEST": "0", "TRUST_PROXY": "1" },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
